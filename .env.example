# Copy to .env before `docker compose up`. Values below are LOCAL-DEV ONLY; rotate everything for any shared environment.

# ---- Host ports (change if something else on your machine already uses them)
AIRFLOW_HOST_PORT=8088
METABASE_HOST_PORT=3000
N8N_HOST_PORT=5680
MAILPIT_HOST_PORT=8025
CRM_API_HOST_PORT=8001

# ---- Postgres (superuser + per-app roles)
POSTGRES_PASSWORD=postgres_dev_pw
POSTGRES_HOST_PORT=5433
ETL_DB_PASSWORD=etl_dev_pw
BI_DB_PASSWORD=bi_dev_pw
ALERTING_DB_PASSWORD=alerting_dev_pw
AIRFLOW_DB_PASSWORD=airflow_dev_pw
N8N_DB_PASSWORD=n8n_dev_pw
METABASE_DB_PASSWORD=metabase_dev_pw

# ---- Source system simulation
SIM_START_DATE=2026-04-01
SIM_SEED=42
EXPORT_INTERVAL_SECONDS=900
CRM_API_KEY=local-dev-crm-key
CRM_API_FAILURE_RATE=0.05

# ---- Airflow
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=Afm8e1btaYmxQ5YPSLCDWBg_N_LE7mipApT6La9JTlg=
AIRFLOW_JWT_SECRET=QEj4jhEJpBG8CTRI7XzR0_AMeYP2VqseO7l70xfoIHA
AIRFLOW_API_SECRET_KEY=wse7QrWuNGLLHZZy3XK6x4fHeZKembQx
MAX_REJECT_RATE=0.05

# ---- n8n alerting (owner is auto-created on first start)
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_PASSWORD=N8n-demo-pw1
N8N_ENCRYPTION_KEY=ab4fd76b13fbb6edc268952bd77c2295e830533e71106248
SLA_COMPLIANCE_THRESHOLD=90
BACKLOG_THRESHOLD=350
ALERT_COOLDOWN_MINUTES=120
ALERT_EMAIL_TO=cc-managers@example.com
ALERT_EMAIL_FROM=sla-alerts@example.com
# Optional: a Slack incoming-webhook URL. Leave empty to skip Slack (email + alert_log still fire).
SLACK_WEBHOOK_URL=

# ---- Metabase
